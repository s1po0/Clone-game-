<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="pages/" />
        <include domain="file" path="books/" />
        <!-- Credentials are Keystore-encrypted and device-bound; a backup copy is useless
             anywhere else and is still a secret, so it never leaves the device. -->
        <exclude domain="file" path="secrets.bin" />
        <exclude domain="file" path="secrets.bin.tmp" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="pages/" />
        <include domain="file" path="books/" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
