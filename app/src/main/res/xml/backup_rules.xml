<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="pages/" />
    <include domain="file" path="books/" />
    <include domain="sharedpref" path="." />
    <!-- Credentials live in secrets.bin, encrypted with a Keystore key that cannot be backed
         up: the file is excluded so a restore cannot leave a half-usable secret behind. -->
    <exclude domain="file" path="secrets.bin" />
    <exclude domain="file" path="secrets.bin.tmp" />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
